# Builds a clean `git worktree` of HEAD — not the working tree — and
# type-checks it with `npx tsc --noEmit`. A worktree only contains what's
# committed, so an import (or a fetch("/api/...") target) that exists on
# disk but was never `git add`ed still fails here exactly like it fails
# on Vercel's clean clone — that's the bug this hook exists for, and a
# clean checkout is what catches it, independent of whether the check
# itself is a typecheck or a full build.
#
# Was previously a full `npm ci && npm run build` (Vercel's own
# pipeline) — changed 2026-08-13: both real failures this hook has
# caught were TypeScript errors surfaced in `next build`'s own typecheck
# phase, not bundling failures, and Vercel catches a bundling failure on
# its own in under a minute anyway. This drops that bundling
# verification — a real gap, accepted deliberately for the runtime win.
#
# Reuses this checkout's own node_modules (symlinked, no npm ci) instead
# of a fresh install — node_modules isn't part of what "committed but
# not on disk" catches, only source files are, and a symlink is instant
# where npm ci is not.
#
# Skip once, deliberately, with:
#   git push --no-verify
set -e

WORKTREE_DIR=$(mktemp -d /tmp/pre-push-verify.XXXXXX)
cleanup() {
  git worktree remove "$WORKTREE_DIR" --force >/dev/null 2>&1 || true
  rm -rf "$WORKTREE_DIR"
}
trap cleanup EXIT

echo "[pre-push] Type-checking a clean worktree of HEAD..."
git worktree add "$WORKTREE_DIR" HEAD --quiet

ln -s "$(pwd)/node_modules" "$WORKTREE_DIR/node_modules"

(
  cd "$WORKTREE_DIR"
  npx tsc --noEmit
)

echo "[pre-push] Clean-worktree typecheck passed."
